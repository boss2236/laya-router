#!/usr/bin/python3
"""Called by bash's command_not_found_handle: laya-fix <shell-pid> <cwd> <typed words...>

Asks the Laya router (laya-router.socket) what was meant, then:
  app    -> launch it      } without asking for one clear spelling match, or a fix you have
  folder -> cd into it     } confirmed before; otherwise an arrow-key menu
  command-> asks (until you've confirmed the same fix 3 times), then hands the corrected line
            back to the shell to run
Every pick (or "none of these") is remembered in learn.py's picks.json.
Exit 0 = handled (including "user said no"), 10 = not handled (bash falls back).
Work for the parent shell is written to $XDG_RUNTIME_DIR/laya-pending.<shell-pid>.
"""
import json
import os
import select
import shlex
import socket
import subprocess
import sys
import termios
import tty

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
import learn  # noqa: E402  (lives in the repo next to server.py; this file is symlinked)

NOT_HANDLED = 10

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
SOCK = os.path.join(RUNTIME, "laya-router.sock")
DIM, BOLD, CYAN, RESET = "\033[2m", "\033[1m", "\033[36m", "\033[0m"
CLEAR_LINE, HIDE, SHOW = "\033[2K\r", "\033[?25l", "\033[?25h"
NONE = {"label": "none of these"}


class Tty:
    """The terminal, opened twice: Python cannot open a tty "r+" (it is not seekable)."""

    def __init__(self):
        self.out = open("/dev/tty", "w")
        self.fd = os.open("/dev/tty", os.O_RDONLY)

    def write(self, s):
        self.out.write(s)

    def flush(self):
        self.out.flush()

    def key(self):
        """One keypress: "up", "down", "enter", "esc", or the character typed."""
        b = os.read(self.fd, 1)
        if b == b"\x1b":
            # Exactly one escape sequence: keys pressed quickly arrive in the same read.
            if not select.select([self.fd], [], [], 0.03)[0]:
                return "esc"
            seq = os.read(self.fd, 1)
            if seq in (b"[", b"O"):
                while True:
                    c = os.read(self.fd, 1)
                    seq += c
                    if not c or 0x40 <= c[0] <= 0x7E:  # final byte of a CSI / SS3 sequence
                        break
            return {b"[A": "up", b"OA": "up", b"[B": "down", b"OB": "down", b"[H": "home", b"OH": "home",
                    b"[1~": "home", b"[F": "end", b"OF": "end", b"[4~": "end"}.get(seq, "")
        if b in (b"\r", b"\n"):
            return "enter"
        if b == b"\x03":
            return "esc"  # Ctrl+C: cbreak mode still delivers SIGINT, but just in case
        return b.decode(errors="ignore")


def say(t, msg):
    t.write(f"{CYAN}laya{RESET} {msg}\n")
    t.flush()


def ask_router(t, line, cwd):
    if not os.path.exists(SOCK):
        return None
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(SOCK)
        s.sendall((json.dumps({"line": line, "cwd": cwd}) + "\n").encode())
        s.settimeout(0.7)
        data = b""
        warned = False
        while not data.endswith(b"\n"):
            try:
                chunk = s.recv(65536)
            except socket.timeout:
                if warned:
                    return None
                say(t, f"{DIM}waking up the model (a few seconds)…{RESET}")
                warned = True
                s.settimeout(30)
                continue
            if not chunk:
                break
            data += chunk
        return json.loads(data)
    except (OSError, ValueError) as e:
        if os.environ.get("LAYA_DEBUG"):
            say(t, f"router error: {e!r}")
        return None
    finally:
        s.close()


def shown(c):
    """What a choice reads as: the line that will run, or the thing that will open."""
    return c.get("run") or c["label"]


def act(c, shell_pid):
    pending = os.path.join(RUNTIME, f"laya-pending.{shell_pid}")
    if c["kind"] == "app":
        subprocess.Popen(["setsid", "uwsm-app", "--", c["target"]],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif c["kind"] == "folder":
        with open(pending, "w") as f:
            f.write("cd -- " + shlex.quote(c["target"]))
    else:
        with open(pending, "w") as f:
            f.write(c["run"])


def menu(t, title, items):
    """Arrow-key picker. ↑/↓ (or j/k, Tab) move, Enter picks, a digit picks that row, Esc/q cancels.

    Returns the chosen item or None. The menu is erased afterwards, leaving one line behind.
    """
    sel, n = 0, len(items)
    old = termios.tcgetattr(t.fd)
    t.write(HIDE)
    try:
        tty.setcbreak(t.fd)
        first = True
        while True:
            if not first:
                t.write(f"\033[{n + 2}A")  # back to the title line
            first = False
            t.write(f"{CLEAR_LINE}{CYAN}laya{RESET} {title}\n")
            for i, it in enumerate(items):
                text = it["label"] if it is NONE else shown(it)
                num = f"{DIM}{i + 1}{RESET}"
                if i == sel:
                    t.write(f"{CLEAR_LINE}  {CYAN}❯{RESET} {num} {BOLD}{text}{RESET}\n")
                else:
                    t.write(f"{CLEAR_LINE}    {num} {DIM if it is NONE else ''}{text}{RESET}\n")
            t.write(f"{CLEAR_LINE}    {DIM}↑↓ move · Enter pick · Esc cancel{RESET}\n")
            t.flush()
            k = t.key()
            if k in ("up", "k"):
                sel = (sel - 1) % n
            elif k in ("down", "j", "\t"):
                sel = (sel + 1) % n
            elif k == "home":
                sel = 0
            elif k == "end":
                sel = n - 1
            elif k == "enter":
                break
            elif k in ("esc", "q", "n"):
                sel = None
                break
            elif k.isdigit() and 1 <= int(k) <= n:
                sel = int(k) - 1
                break
    finally:
        termios.tcsetattr(t.fd, termios.TCSADRAIN, old)
        t.write(f"\033[{n + 2}A")
        for _ in range(n + 2):
            t.write(f"{CLEAR_LINE}\n")
        t.write(f"\033[{n + 2}A{SHOW}")
        t.flush()
    return None if sel is None else items[sel]


def main():
    if len(sys.argv) < 4:
        return NOT_HANDLED
    shell_pid, cwd, words = sys.argv[1], sys.argv[2], sys.argv[3:]
    line = " ".join(words)
    try:
        t = Tty()
    except OSError:
        return NOT_HANDLED
    reply = ask_router(t, line, cwd)
    if not reply or reply.get("error") or not reply.get("candidates"):
        return NOT_HANDLED
    cands = reply["candidates"]

    if reply.get("auto"):
        top = cands[0]
        verb = {"app": "opening", "folder": "going to", "command": "running"}[top["kind"]]
        say(t, f"{DIM}{line} →{RESET} {verb} {BOLD}{shown(top)}{RESET}")
        learn.record(line, top)
        act(top, shell_pid)
        return 0

    title = ("did you mean" if reply.get("mode") == "spelling" else "open") + f" {DIM}({line}){RESET}"
    try:
        choice = menu(t, title, cands + [NONE])
    except KeyboardInterrupt:
        choice = None
    if choice is NONE:
        learn.record(line, None)
        data, key = learn.load(), learn.norm(line)
        rejects = data["rejects"].get(key, 0)
        quiet = rejects >= learn.GIVE_UP and rejects > sum(data["lines"].get(key, {}).values())
        say(t, f"{DIM}{line} → " + ("ok, I'll stay quiet for this from now on" if quiet else "nothing") + RESET)
        return 0
    if choice is None:
        say(t, f"{DIM}{line} → cancelled{RESET}")
        return 0
    say(t, f"{DIM}{line} →{RESET} {BOLD}{shown(choice)}{RESET}")
    learn.record(line, choice)
    act(choice, shell_pid)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
